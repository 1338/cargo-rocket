# Template only. Export values in your shell for cargo run.
# Docker Compose reads .env for interpolation.
# Generate a fresh admin token with: openssl rand -hex 32
ADMIN_TOKEN=
PUBLIC_BASE_URL=http://localhost:3000
BIND_ADDR=127.0.0.1:3000
DATABASE_PATH=data/upload-tool.db
CORS_ORIGINS=
RUST_LOG=rocket_cargo=info
# Remote credentials must also be passed to the container explicitly.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AZURE_STORAGE_KEY=
# FTP_PASSWORD=
